{
  "name": "dsh-imagekit",
  "version": "0.0.5",
  "description": "本地生图与放大：Qwen-Image 生成 / 改图、Vulkan 超分、像素处理，附 ComfyUI 引擎与显存监测（DeepSeek Harness 插件）",
  "license": "MIT",
  "author": "ikeyuchen (https://github.com/ikeyuchen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikeyuchen/dsh-imagekit.git"
  },
  "homepage": "https://github.com/ikeyuchen/dsh-imagekit#readme",
  "bugs": {
    "url": "https://github.com/ikeyuchen/dsh-imagekit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "image-generation",
    "image-editing",
    "image-upscaling",
    "image-processing",
    "comfyui",
    "qwen-image",
    "realcugan",
    "waifu2x",
    "vulkan",
    "local-ai",
    "vram"
  ],
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/**/*.js",
    "lib/**/*.mjs",
    "scripts/pixels.py",
    "tiers.json",
    "styles.json",
    "models.manifest.json",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY.md",
    "THIRD_PARTY_LICENSES/*.txt",
    "docs/*.md",
    "docs/*.png",
    "docs/*.webp"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:download": "node scripts/test-download.mjs",
    "test:backup": "node scripts/test-backup.mjs",
    "test:setup": "node scripts/test-setup-tool.mjs",
    "test:upscale": "node scripts/test-upscale-archive.mjs",
    "test:output": "node scripts/test-output-dir.mjs",
    "test:paths": "node scripts/test-paths.mjs",
    "test": "npm run check && npm run test:download && npm run test:backup && npm run test:setup && npm run test:upscale && npm run test:output && npm run test:paths && npm run test:prompt && npm run test:styles && npm run test:route && npm run test:guards && npm run test:gateway && npm run test:docs",
    "prepublishOnly": "npm test && node scripts/release.mjs --check",
    "test:prompt": "node scripts/test-prompt-routing.mjs",
    "test:styles": "node scripts/test-styles.mjs",
    "test:guards": "node scripts/test-tool-guards.mjs",
    "test:gateway": "node scripts/test-gateway.mjs",
    "tokens": "node scripts/token-report.mjs",
    "test:docs": "node scripts/doc-drift.mjs",
    "test:route": "node scripts/test-route.mjs",
    "test:e2e": "node scripts/test-upgrade-real.mjs",
    "release": "node scripts/release.mjs",
    "release:beta": "node scripts/release-beta.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  }
}
